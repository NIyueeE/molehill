# Podman Quadlet: run the molehill server as a systemd service.
#
# Root install:
#   sudo cp molehill-server.container /etc/containers/systemd/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now molehill-server
#
# Rootless install (change WantedBy= to default.target):
#   mkdir -p ~/.config/containers/systemd
#   cp molehill-server.container ~/.config/containers/systemd/
#   systemctl --user daemon-reload
#   systemctl --user enable --now molehill-server

[Unit]
Description=Molehill server (container)
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/niyueee/molehill:latest
# Host path of the config file; mounted read-only.
Volume=/etc/molehill/server.toml:/app/server.toml:ro
# Host networking keeps the server's service ports reachable directly.
Network=host
Environment=RUST_LOG=info
# Argument passed to the image entrypoint (./molehill).
Exec=server.toml

[Service]
Restart=always

[Install]
WantedBy=multi-user.target

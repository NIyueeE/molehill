#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

if ! command -v just >/dev/null 2>&1; then
    printf '%s\n' "error: 'just' is not installed. See https://github.com/casey/just" >&2
    exit 1
fi

for tool in cargo-audit cargo-outdated cargo-machete; do
    if ! command -v "$tool" >/dev/null 2>&1; then
        printf '%s\n' "error: '$tool' is not installed." >&2
        printf '%s\n' "  Install it with: cargo install $tool" >&2
        exit 1
    fi
done

exec just check

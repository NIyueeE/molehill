#!/usr/bin/env bash
# Pre-push hook (heavyweight gates + tag review dispatch): audit + dependency
# policy + freshness + tests guard every branch push. A push carrying a `v*`
# tag is a release act (AGENTS.md §5): the light release review
# (githooks/pre-tag) runs for it, and a tag-only push stops there — the tagged
# commit's heavy gates ran when its branch was pushed, and re-running them
# would make the release depend on the local machine and its flakes. git has
# no native tag hook, so pre-push is where the review fires automatically.
# Fast gates live in githooks/pre-commit.
# Activate via: git config core.hooksPath githooks   (or: just setup)
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# Consume the pushed refs from stdin before running anything; `v*` tag pushes
# get the release review ahead of the heavy gates, and a push that only
# deletes branches is not a change set at all — it carries no commits, so the
# heavy gates have nothing to judge (a deleted `v*` tag is not that case).
# (A manual run from a terminal reads nothing, like the hook always did.)
pushed_any=0
tag_pushed=0
tag_deleted=0
branch_pushed=0
deletions=0
docs_only=1
benches_only=1
if [ ! -t 0 ]; then
  zeros="0000000000000000000000000000000000000000"
  while read -r local_ref local_sha remote_ref remote_sha; do
    case "$local_ref" in
      refs/tags/v*)
        if [ "$local_sha" != "$zeros" ]; then
          tag_pushed=1
          echo "==> release tag pushed: $local_ref"
          githooks/pre-tag --tag "${local_ref#refs/tags/}" --commit "$(git rev-parse --verify "$local_sha^{commit}")"
        else
          # Deleting a release tag is a release act too: it gets no shortcut.
          tag_deleted=1
        fi
        ;;
      *)
        if [ "$local_sha" != "$zeros" ]; then
          branch_pushed=1
        elif [ "$remote_sha" != "$zeros" ]; then
          # A ref that existed on the remote and is going away: it carries no
          # commits for the heavy gates to judge.
          deletions=$((deletions + 1))
        fi
        ;;
    esac
    # Classify the commits this push carries: a branch push whose commits only
    # touch markdown/docs/assets cannot move audit/deny/outdated/test, so it
    # runs the doc gate instead (the same split CI makes). The same holds for
    # bench/** (githooks/benches-only): the project is runtime
    # tooling, never compiled, so no Rust gate can move and the doc gate — the
    # one gate a bench-project change CAN move (the metric registry) — runs
    # alone. A push mixing docs with benches (or either with code) fails both
    # classifiers and takes the full chain: the safe direction. A tag push
    # never takes the shortcut.
    if [ "$local_sha" != "$zeros" ] && [ "$remote_sha" != "$zeros" ]; then
      pushed_any=1
      git diff --name-only "$remote_sha" "$local_sha" | githooks/docs-only || docs_only=0
      git diff --name-only "$remote_sha" "$local_sha" | githooks/benches-only || benches_only=0
    elif [ "$local_sha" != "$zeros" ]; then
      pushed_any=1
      docs_only=0    # a new branch: nothing to compare against, run everything
      benches_only=0
    fi
  done
fi

# A tag-only push is the release act: the review above is its gate, and the
# tagged commit's heavy gates ran when its branch was pushed. Re-running them
# here would make the release depend on the local machine and its flakes. If
# the tag's commit never went through a branch push, run `just check` on it
# first.
if [ "$tag_pushed" -eq 1 ] && [ "$branch_pushed" -eq 0 ]; then
  echo "==> tag-only push: release review passed; heavy gates already ran on the commit"
  exit 0
fi

# A deletion is not a change set: the pushed refs name only commits that are
# going away, so audit, deny, outdated and the test suite have nothing to
# judge and the push stops after classification. A deleted `v*` tag is not
# covered (see above): it falls through to the heavy chain rather than take a
# shortcut on a release act.
if [ "$deletions" -gt 0 ] && [ "$pushed_any" -eq 0 ] && [ "$tag_deleted" -eq 0 ]; then
  echo "==> deletion-only push: no commits to gate; skipping audit / deny / outdated / test"
  echo "pre-push checks passed (deletion-only)"
  exit 0
fi

if [ "$pushed_any" -eq 1 ] && [ "$tag_pushed" -eq 0 ] && { [ "$docs_only" -eq 1 ] || [ "$benches_only" -eq 1 ]; }; then
  if [ "$docs_only" -eq 1 ]; then
    echo "==> docs-only push: skipping audit / deny / outdated / test"
  else
    echo "==> benches-only push: skipping audit / deny / outdated / test (no Rust gate can move)"
  fi
  echo "==> docs alignment (githooks/check-docs)"
  githooks/check-docs
  if [ "$docs_only" -eq 1 ]; then
    echo "pre-push checks passed (docs-only)"
  else
    echo "pre-push checks passed (benches-only)"
  fi
  exit 0
fi

echo "==> cargo audit (security advisories)"
cargo audit

echo "==> cargo deny (licenses / bans / advisories policy)"
cargo deny check

echo "==> cargo outdated (root dependencies)"
cargo outdated --root-deps-only

echo "==> cargo test (serial by design — the integration suite binds fixed ports)"
cargo test --quiet -- --test-threads=1

echo "pre-push checks passed"

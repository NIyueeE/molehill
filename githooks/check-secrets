#!/usr/bin/env bash
# Secret scan on staged changes (pre-commit gate).
# Fails the commit when a staged line looks like a credential. A line that
# must carry a secret-shaped string (e.g. key-format documentation) takes the
# marker `security-scan:allow` with a reason; such lines are skipped.
# See AGENTS.md §9 (secrets never enter the repository).
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

ADDED=$(git diff --cached -U0 | grep '^[+][^+]' | sed 's/^[+]//' | grep -v 'security-scan:allow' || true)
if [ -z "$ADDED" ]; then
  echo "  secret scan ok (nothing staged to scan)"
  exit 0
fi

hits=0
while IFS=$'\t' read -r name regex; do
  [ -n "$name" ] || continue
  match_out=$(grep -Ein -- "$regex" <<<"$ADDED" \
    | grep -Eiv '\{\{|<[^>]*>|\.\.\.|changeme|placeholder|example|dummy|sample|your[_-]?key|your[_-]?token' \
    || true)
  if [ -n "$match_out" ]; then
    echo "  FAIL  possible $name:"
    printf '%s\n' "$match_out" | head -5 | sed 's/^/        /'
    hits=$((hits + 1))
  fi
done <<'EOF'
private key block	-----BEGIN [A-Z ]*PRIVATE KEY-----
aws access key	AKIA[0-9A-Z]{16}
github token	gh[pousr]_[A-Za-z0-9]{20,}
github fine-grained token	github_pat_[A-Za-z0-9_]{20,}
slack token	xox[abprs]-[A-Za-z0-9-]{10,}
google api key	AIza[0-9A-Za-z_-]{35}
generic credential	(api[_-]?key|apikey|secret|token|password|passwd|pwd)[[:space:]]*[:=][[:space:]]*["']?[A-Za-z0-9+/_-]{16,}
EOF

if [ "$hits" -eq 0 ]; then
  echo "  secret scan ok"
else
  echo "  $hits secret-scan rule(s) matched. If a line must carry a" >&2
  echo "  secret-shaped string, add the marker 'security-scan:allow' with a" >&2
  echo "  reason; never commit real credentials." >&2
  exit 1
fi

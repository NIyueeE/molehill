#!/usr/bin/env bash
# Classify a change set: is every changed path a docs path?
#
# Reads paths (one per line) on stdin; exits 0 when all of them are markdown,
# `docs/**` or `assets/**`, and 1 otherwise. The three patterns are exactly
# `.github/workflows/ci.yml`'s `paths-ignore` (and docs.yml's `paths`), so the
# hooks and CI agree on what "docs-only" means — a disagreement here would let
# a code change skip the Rust gates locally and then fail in CI, or vice versa.
#
# Callers (githooks/pre-commit, githooks/pre-push) use it to skip the gates a
# docs-only change cannot move. The two gates it can move always run: the
# secret scan (a leaked key in a README is still a leaked key) and the
# docs-alignment check.
#
# An empty input is NOT docs-only: a hook with nothing to classify should not
# claim the shortcut. Deleting this file would make both hooks run the full
# chain again, which is the safe direction.
set -euo pipefail

if [ -t 0 ]; then
  # A manual run from a terminal has no change set to classify.
  exit 1
fi

docs_only=1
saw_path=0
while IFS= read -r path; do
  [ -n "$path" ] || continue
  saw_path=1
  case "$path" in
    *.md | docs/* | assets/*) ;;
    *) docs_only=0 ;;
  esac
done

[ "$saw_path" -eq 1 ] || exit 1
[ "$docs_only" -eq 1 ]

#!/usr/bin/env bash
# Docs-alignment check: verify the modular docs (docs/ + README landing pages)
# still describe the actual code (hook commands, lints, toolchain, edition,
# justfile, CI).
# Covers greppable invariants only; semantic alignment stays with the agent/human.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

errors=0

expect() {
  # expect <description> <file> <fixed-string-pattern>
  local desc="$1" file="$2" pattern="$3"
  if grep -qF -- "$pattern" "$file"; then
    echo "  ok    $desc"
  else
    echo "  FAIL  $desc -> missing '$pattern' in $file" >&2
    errors=$((errors + 1))
  fi
}

# 1) every command a hook runs must be documented in the checks docs. The
#    filter keeps real commands (cargo/uvx/git/just and the repo's own gates)
#    and drops shell builtins, assignments and comments, so a gate that is
#    renamed in a hook immediately shows up as a docs failure here.
for hook in githooks/pre-commit githooks/pre-push githooks/pre-tag; do
  if [ ! -f "$hook" ]; then
    echo "  FAIL  $hook missing (see docs/checks.md)" >&2
    errors=$((errors + 1))
    continue
  fi
  # Extract the gate *commands*, not whole shell lines: a hook line may be a
  # pipeline or carry control flow (`git diff … | githooks/docs-only || x=0`),
  # and requiring that literal text in the docs would document noise. The
  # reverse check below extracts commands the same way, so both directions
  # speak about the same thing.
  while IFS= read -r cmd; do
    [ -n "$cmd" ] || continue
    expect "[$hook] command documented: $cmd" docs/checks.md "$cmd"
  done < <(sed -e 's/[[:space:]]*#.*$//' "$hook" \
             | grep -oE '(cargo [a-z-]+|uvx [a-z]+|just [a-z-]+|githooks/[a-z-]+)' \
             | sort -u)
done

# 1b) the reverse direction: every gate docs/checks.md presents as a command
#     must still exist somewhere in the hooks. Without this a gate can be
#     deleted while its documentation keeps claiming it runs.
while IFS= read -r cmd; do
  [ -n "$cmd" ] || continue
  found=0
  for hook in githooks/pre-commit githooks/pre-push githooks/pre-tag; do
    if grep -qF -- "$cmd" "$hook" 2>/dev/null; then found=1; break; fi
  done
  if [ "$found" -eq 1 ]; then
    echo "  ok    documented gate still exists: $cmd"
  else
    echo "  FAIL  docs/checks.md documents a gate no hook runs: $cmd" >&2
    errors=$((errors + 1))
  fi
done < <(awk '
           /^## / { in_gate = ($0 ~ /pre-commit|pre-push|pre-tag/) }
           in_gate { print }
         ' docs/checks.md \
           | grep -oE '`(cargo [a-z-]+|uvx [a-z]+|githooks/[a-z-]+)[^`]*`' \
           | tr -d '`' | sort -u)

# 2) every lint declared in Cargo.toml [lints] must be documented in the lint-policy docs
while IFS= read -r lint; do
  [ -n "$lint" ] || continue
  expect "lint documented: $lint" docs/lint-policy.md '`'"$lint"'`'
done < <(awk '/^\[lints\./{f=1;next} /^\[/{f=0}
              # comments are prose, not lint declarations: a `=` inside one
              # (e.g. a code sample) is not a lint level
              f && /=/ && $0 !~ /^[ \t]*#/ {
                split($0,a,"="); k=a[1]; gsub(/[ \t]/,"",k); if (k != "") print k
              }' Cargo.toml)

# 3) rustc edition
edition=$(sed -n 's/^edition = "\(.*\)"/\1/p' Cargo.toml)
if [ -n "$edition" ]; then
  expect "edition documented: $edition" README.md "${edition} edition"
  expect "edition documented: $edition" README.zh.md "${edition} edition"
fi

# 4) toolchain channel
channel=$(sed -n 's/^channel = "\(.*\)"/\1/p' rust-toolchain.toml)
if [ -n "$channel" ]; then
  expect "toolchain channel documented: $channel" README.md "channel = \"$channel\""
  expect "toolchain channel documented: $channel" README.zh.md "channel = \"$channel\""
fi

# 5) justfile recipes documented on the landing pages
expect "just setup documented" README.md 'just setup'
expect "just setup documented" README.zh.md 'just setup'
expect "just check documented" README.md 'just check'
expect "just check documented" README.zh.md 'just check'
# The benchmark commands live on the method's page (one topic, one home);
# the READMEs link to it instead of repeating the recipe.
expect "just soak documented" docs/benchmarks.md 'just soak'
expect "just soak documented (zh)" docs/benchmarks.zh.md 'just soak'
expect "just soak-check documented" docs/benchmarks.md 'just soak-check'
expect "just soak-peers documented" docs/benchmarks.md 'just soak-peers'

# 6) hooks activation instruction
expect "hooksPath instruction documented" README.md 'core.hooksPath githooks'
expect "hooksPath instruction documented" README.zh.md 'core.hooksPath githooks'

# 7) docs gate itself must stay documented in the checks docs
expect "docs gate documented" docs/checks.md 'githooks/check-docs'

# 8) READMEs must link the modular governance docs (index integrity, per language)
for doc in checks lint-policy release structure; do
  expect "README links docs/$doc.md" README.md "docs/$doc.md"
  expect "README.zh links docs/$doc.md" README.zh.md "docs/$doc.md"
done

# 8b) user-facing docs keep a Chinese mirror and both READMEs link the page
#     in their own language (AGENTS.md §3)
for doc in configuration transport benchmarks; do
  expect "docs/$doc.md linked from README" README.md "docs/$doc.md"
  expect "docs/$doc.zh.md linked from README.zh" README.zh.md "docs/$doc.zh.md"
  if [ ! -f "docs/$doc.zh.md" ]; then
    echo "  FAIL  docs/$doc.zh.md missing (user-facing docs keep a mirror)" >&2
    errors=$((errors + 1))
    continue
  fi
  # A section added to one language only is the usual way a mirror drifts:
  # the heading count is a cheap, greppable proxy for "same structure".
  en_headings=$(grep -c '^#' "docs/$doc.md")
  zh_headings=$(grep -c '^#' "docs/$doc.zh.md")
  if [ "$en_headings" -eq "$zh_headings" ]; then
    echo "  ok    docs/$doc.md and its mirror have the same structure ($en_headings headings)"
  else
    echo "  FAIL  docs/$doc.md has $en_headings headings, docs/$doc.zh.md has $zh_headings — the mirror drifted" >&2
    errors=$((errors + 1))
  fi
done

# 8c) the ownership contract lists every docs/ page, so a new page without a
#     stated owner (and audience) fails here instead of drifting
while IFS= read -r page; do
  name="$(basename "$page")"
  case "$name" in
    *.zh.md) continue ;;
  esac
  if grep -qF "\`$name\`" docs/structure.md; then
    echo "  ok    docs/$name has an owner in docs/structure.md"
  else
    echo "  FAIL  docs/$name is not listed in docs/structure.md's ownership table" >&2
    errors=$((errors + 1))
  fi
done < <(git ls-files 'docs/*.md')

# 9) CI must run the same chain
if [ -f .github/workflows/ci.yml ]; then
  expect "CI runs the full chain" .github/workflows/ci.yml 'just check'
else
  echo "  FAIL  .github/workflows/ci.yml missing (README badge references it)" >&2
  errors=$((errors + 1))
fi

# 10) release notes must be extracted from CHANGELOG.md
if [ -f .github/workflows/release.yml ]; then
  expect "release notes extracted from CHANGELOG" .github/workflows/release.yml 'CHANGELOG.md'
  expect "release docs mention CHANGELOG" docs/release.md 'CHANGELOG'
else
  echo "  FAIL  .github/workflows/release.yml missing (see docs/release.md)" >&2
  errors=$((errors + 1))
fi

# 11) CD test builds: manual dispatch only, never a release, documented
if [ -f .github/workflows/test-build.yml ]; then
  expect "test builds are manual (workflow_dispatch)" .github/workflows/test-build.yml 'workflow_dispatch'
  expect "test builds documented" docs/release.md 'test-build.yml'
else
  echo "  FAIL  .github/workflows/test-build.yml missing (see AGENTS.md §6)" >&2
  errors=$((errors + 1))
fi

# 12) HANDOFF.md: agent-facing state notes exist and are referenced
if [ -f HANDOFF.md ]; then
  expect "README links HANDOFF.md" README.md 'HANDOFF.md'
  expect "README links HANDOFF.md" README.zh.md 'HANDOFF.md'
  expect "AGENTS.md references HANDOFF.md" AGENTS.md 'HANDOFF.md'
else
  echo "  FAIL  HANDOFF.md missing (AGENTS.md points to it for working state)" >&2
  errors=$((errors + 1))
fi

# 13) secret scan gate wired into the chain and documented
if [ -f githooks/check-secrets ]; then
  expect "secret scan gate wired" githooks/pre-commit 'githooks/check-secrets'
  expect "secret scan documented" docs/checks.md 'githooks/check-secrets'
else
  echo "  FAIL  githooks/check-secrets missing (AGENTS.md §9 secrets discipline)" >&2
  errors=$((errors + 1))
fi

# 14) pre-tag release review: wired into pre-push and documented
if [ -f githooks/pre-tag ]; then
  expect "pre-tag review wired" githooks/pre-push 'githooks/pre-tag'
  expect "pre-tag review documented" docs/checks.md 'githooks/pre-tag'
  expect "pre-tag review in AGENTS.md" AGENTS.md 'githooks/pre-tag'
else
  echo "  FAIL  githooks/pre-tag missing (light release review, see AGENTS.md §5)" >&2
  errors=$((errors + 1))
fi

# soft notice: stale upstream references are expected only in provenance docs
if grep -qiF 'rathole-org' README.md README.zh.md 2>/dev/null; then
  echo "  note: upstream 'rathole-org' references present (expected: provenance links only)"
fi

if [ "$errors" -eq 0 ]; then
  echo "  docs alignment ok"
else
  echo "  $errors docs alignment issue(s) found" >&2
  exit 1
fi

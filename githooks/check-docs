#!/usr/bin/env bash
# Docs-alignment check: verify the modular docs (docs/ + README landing pages)
# still describe the actual code (hook commands, lints, toolchain, edition,
# justfile, CI).
# Covers greppable invariants only; semantic alignment stays with the agent/human.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

errors=0

expect() {
  # expect <description> <file> <fixed-string-pattern>
  local desc="$1" file="$2" pattern="$3"
  if grep -qF -- "$pattern" "$file"; then
    echo "  ok    $desc"
  else
    echo "  FAIL  $desc -> missing '$pattern' in $file" >&2
    errors=$((errors + 1))
  fi
}

# 1) every command a hook runs must be documented in the checks docs. The
#    filter keeps real commands (cargo/uv/git/just and the repo's own gates)
#    and drops shell builtins, assignments and comments, so a gate that is
#    renamed in a hook immediately shows up as a docs failure here.
for hook in githooks/pre-commit githooks/pre-push githooks/pre-tag; do
  if [ ! -f "$hook" ]; then
    echo "  FAIL  $hook missing (see docs/checks.md)" >&2
    errors=$((errors + 1))
    continue
  fi
  # Extract the gate *commands*, not whole shell lines: a hook line may be a
  # pipeline or carry control flow (`git diff … | githooks/docs-only || x=0`),
  # and requiring that literal text in the docs would document noise. The
  # reverse check below extracts commands the same way, so both directions
  # speak about the same thing.
  while IFS= read -r cmd; do
    [ -n "$cmd" ] || continue
    expect "[$hook] command documented: $cmd" docs/checks.md "$cmd"
  done < <(sed -e 's/[[:space:]]*#.*$//' "$hook" \
             | grep -oE '(cargo [a-z-]+|uv [a-z]+|just [a-z-]+|githooks/[a-z-]+)' \
             | sort -u)
done

# 1b) the reverse direction: every gate docs/checks.md presents as a command
#     must still exist somewhere in the hooks. Without this a gate can be
#     deleted while its documentation keeps claiming it runs.
while IFS= read -r cmd; do
  [ -n "$cmd" ] || continue
  found=0
  for hook in githooks/pre-commit githooks/pre-push githooks/pre-tag; do
    if grep -qF -- "$cmd" "$hook" 2>/dev/null; then found=1; break; fi
  done
  if [ "$found" -eq 1 ]; then
    echo "  ok    documented gate still exists: $cmd"
  else
    echo "  FAIL  docs/checks.md documents a gate no hook runs: $cmd" >&2
    errors=$((errors + 1))
  fi
done < <(awk '
           /^## / { in_gate = ($0 ~ /pre-commit|pre-push|pre-tag/) }
           in_gate { print }
         ' docs/checks.md \
           | grep -oE '`(cargo [a-z-]+|uv [a-z]+|githooks/[a-z-]+)[^`]*`' \
           | tr -d '`' | sort -u)

# 2) every lint declared in Cargo.toml [lints] must be documented in the lint-policy docs
while IFS= read -r lint; do
  [ -n "$lint" ] || continue
  expect "lint documented: $lint" docs/lint-policy.md '`'"$lint"'`'
done < <(awk '/^\[lints\./{f=1;next} /^\[/{f=0}
              # comments are prose, not lint declarations: a `=` inside one
              # (e.g. a code sample) is not a lint level
              f && /=/ && $0 !~ /^[ \t]*#/ {
                split($0,a,"="); k=a[1]; gsub(/[ \t]/,"",k); if (k != "") print k
              }' Cargo.toml)

# 3) rustc edition
edition=$(sed -n 's/^edition = "\(.*\)"/\1/p' Cargo.toml)
if [ -n "$edition" ]; then
  expect "edition documented: $edition" README.md "${edition} edition"
  expect "edition documented: $edition" README.zh.md "${edition} edition"
fi

# 4) toolchain channel
channel=$(sed -n 's/^channel = "\(.*\)"/\1/p' rust-toolchain.toml)
if [ -n "$channel" ]; then
  expect "toolchain channel documented: $channel" README.md "channel = \"$channel\""
  expect "toolchain channel documented: $channel" README.zh.md "channel = \"$channel\""
fi

# 4b) the feature table is a registry: every public feature name (every row
#     except `default`) must be documented in the build guide — the page that
#     owns "what can be compiled". A name documented nowhere is either a dead
#     pipeline row (a `--features` name that gates no code — the rustc
#     `unexpected_cfgs` warning catches the gate side, this catches the table
#     side) or a real feature whose existence is undiscoverable; both fail.
#     This is what keeps the rule "a feature is named by intent, and every
#     name in the table is public API" mechanical.
while IFS= read -r feature; do
  [ -n "$feature" ] || continue
  expect "feature documented: $feature" docs/build-guide.md '`'"$feature"'`'
done < <(awk '/^\[features\]/{f=1;next} /^\[/{f=0}
              f && /=/ && $0 !~ /^[ \t]*#/ {
                split($0,a,"="); k=a[1]; gsub(/[ \t]/,"",k); if (k != "" && k != "default") print k
              }' Cargo.toml)

# 5) justfile recipes documented on the landing pages
expect "just setup documented" README.md 'just setup'
expect "just setup documented" README.zh.md 'just setup'
expect "just check documented" README.md 'just check'
expect "just check documented" README.zh.md 'just check'
# The benchmark commands live on the method's page (one topic, one home);
# the READMEs link to it instead of repeating the recipe.
expect "just bench documented" docs/benchmarks.md 'just bench'
expect "just bench documented (zh)" docs/benchmarks.zh.md 'just bench'
expect "just bench gate documented" docs/benchmarks.md 'just bench gate'
expect "just bench gate documented (zh)" docs/benchmarks.zh.md 'just bench gate'
expect "just bench peers fetch documented" docs/benchmarks.md 'just bench peers fetch'

# 5b) every backticked `just <recipe>` a live page cites must name a recipe the
#     justfile defines. Backticks keep prose ("just the", "just a") out of the
#     check, and the list comes from the justfile itself, so a rename that
#     leaves a page behind fails here instead of dead-ending a reader.
recipes=$(sed -n 's/^\([a-z][a-z0-9-]*\)\( .*\)\{0,1\}:.*/\1/p' justfile | sort -u)
while IFS= read -r recipe; do
  [ -n "$recipe" ] || continue
  if printf '%s\n' "$recipes" | grep -qx -- "$recipe"; then
    echo "  ok    just recipe exists: $recipe"
  else
    echo "  FAIL  a live page cites 'just $recipe', which the justfile does not define" >&2
    errors=$((errors + 1))
  fi
done < <(grep -rhoE '`just [a-z][a-z0-9-]*' README.md README.zh.md docs/*.md \
           | sed 's/^`just //' | sort -u)

# 6) hooks activation instruction
expect "hooksPath instruction documented" README.md 'core.hooksPath githooks'
expect "hooksPath instruction documented" README.zh.md 'core.hooksPath githooks'

# 7) docs gate itself must stay documented in the checks docs
expect "docs gate documented" docs/checks.md 'githooks/check-docs'

# 8) READMEs must link the modular governance docs (index integrity, per language)
for doc in checks lint-policy release structure; do
  expect "README links docs/$doc.md" README.md "docs/$doc.md"
  expect "README.zh links docs/$doc.md" README.zh.md "docs/$doc.md"
done

# 8b) user-facing docs keep a Chinese mirror and both READMEs link the page
#     in their own language (AGENTS.md §3)
#
# Heading levels outside fenced code blocks. A `# comment` inside a TOML or
# shell example is not a heading: a raw `^#` count reads 72 for deployment.md
# against 17 for its mirror, while the structure is identical. Translated text
# differs, so the comparison is the level sequence, not the words.
heading_levels() {
  awk '
    /^[[:space:]]*(```|~~~)/ { fence = !fence; next }
    !fence && /^#+[[:space:]]/ { match($0, /^#+/); print RLENGTH }
  ' "$1"
}

for doc in configuration deployment transport benchmarks; do
  expect "docs/$doc.md linked from README" README.md "docs/$doc.md"
  expect "docs/$doc.zh.md linked from README.zh" README.zh.md "docs/$doc.zh.md"
  if [ ! -f "docs/$doc.zh.md" ]; then
    echo "  FAIL  docs/$doc.zh.md missing (user-facing docs keep a mirror)" >&2
    errors=$((errors + 1))
    continue
  fi
  # A section added to one language only is the usual way a mirror drifts.
  # Compare the level sequence (not the words, which are translated): a
  # reordered section or a changed depth fails here even when the count matches.
  en_levels=$(heading_levels "docs/$doc.md")
  zh_levels=$(heading_levels "docs/$doc.zh.md")
  if [ "$en_levels" = "$zh_levels" ]; then
    count=$(printf '%s\n' "$en_levels" | awk 'NF { n++ } END { print n }')
    echo "  ok    docs/$doc.md and its mirror have the same structure ($count headings)"
  else
    echo "  FAIL  docs/$doc.md and docs/$doc.zh.md have different heading structure — the mirror drifted" >&2
    echo "        en: $(printf '%s' "$en_levels" | tr '\n' ' ')" >&2
    echo "        zh: $(printf '%s' "$zh_levels" | tr '\n' ' ')" >&2
    errors=$((errors + 1))
  fi
done

# 8c) the ownership contract lists every docs/ page with a valid audience.
#     The Audience column is the voice contract (AGENTS.md §3, "Audience and
#     voice"), so a page added without a row — or a row whose audience is not
#     one of the four tiers — fails here instead of drifting.
ownership=$(mktemp)
awk -F'|' '
  /^### Documentation responsibilities/ { section = 1 }
  section && /^\| Doc \| Audience \|/ { in_table = 1; next }
  in_table && /^\|/ {
    doc = $2; aud = $3;
    gsub(/^[ \t]+|[ \t]+$/, "", doc);
    gsub(/^[ \t]+|[ \t]+$/, "", aud);
    if (doc ~ /^-+$/) next;
    print doc "\t" aud
  }
  in_table && !/^\|/ { exit }
' docs/structure.md > "$ownership"

while IFS=$'\t' read -r row_doc row_aud; do
  case "$row_aud" in
    users|contributors|agents|"vulnerability reporters") ;;
    *)
      echo "  FAIL  ownership row '$row_doc' has audience '$row_aud' (expected users, contributors, agents or vulnerability reporters)" >&2
      errors=$((errors + 1))
      ;;
  esac
done < "$ownership"

while IFS= read -r page; do
  name="$(basename "$page")"
  case "$name" in
    *.zh.md) continue ;;
  esac
  if grep -qF -- "\`$name\`" "$ownership"; then
    audience=$(grep -F -- "\`$name\`" "$ownership" | head -1 | cut -f2)
    case "$audience" in
      users|contributors|agents|"vulnerability reporters")
        echo "  ok    docs/$name has an owner (audience: $audience)" ;;
      *)
        echo "  ok    docs/$name has an owner (invalid audience — see the row failure above)" ;;
    esac
  else
    echo "  FAIL  docs/$name is not a row in docs/structure.md's ownership table" >&2
    errors=$((errors + 1))
  fi
done < <(git ls-files 'docs/*.md')
rm -f "$ownership"

# 9) CI must run the same chain
if [ -f .github/workflows/ci.yml ]; then
  expect "CI runs the full chain" .github/workflows/ci.yml 'just check'
else
  echo "  FAIL  .github/workflows/ci.yml missing (README badge references it)" >&2
  errors=$((errors + 1))
fi

# 9b) the docs-only paths are one contract in three places (githooks/docs-only,
#     ci.yml's paths-ignore and docs.yml's paths). docs/checks.md states
#     that they cannot disagree; this asserts it instead of trusting it.
classifier_paths=$(sed -n 's/^[[:space:]]*\([^)]*\)) ;;$/\1/p' githooks/docs-only \
  | tr '|' '\n' \
  | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' \
        -e 's|^docs/\*$|docs/**|' -e 's|^assets/\*$|assets/**|' \
        -e 's|^\*\.\([a-z]*\)$|**.\1|' \
  | sed '/^$/d' | sort -u)
workflow_paths() {
  # The quoted path list under paths: / paths-ignore: (both triggers of a file).
  sed -n 's/^[[:space:]]*-[[:space:]]*"\([^"]*\)"[[:space:]]*$/\1/p' "$1" | sort -u
}
ci_paths=$(workflow_paths .github/workflows/ci.yml)
docs_paths=$(workflow_paths .github/workflows/docs.yml)
if [ "$classifier_paths" = "$ci_paths" ] && [ "$ci_paths" = "$docs_paths" ]; then
  echo "  ok    docs-only paths agree (classifier, ci.yml, docs.yml)"
else
  echo "  FAIL  docs-only paths disagree — update all three:" >&2
  echo "        githooks/docs-only: $(printf '%s' "$classifier_paths" | tr '\n' ' ')" >&2
  echo "        ci.yml            : $(printf '%s' "$ci_paths" | tr '\n' ' ')" >&2
  echo "        docs.yml          : $(printf '%s' "$docs_paths" | tr '\n' ' ')" >&2
  errors=$((errors + 1))
fi

# 10) release notes must be extracted from CHANGELOG.md
if [ -f .github/workflows/release.yml ]; then
  expect "release notes extracted from CHANGELOG" .github/workflows/release.yml 'CHANGELOG.md'
  expect "release docs mention CHANGELOG" docs/release.md 'CHANGELOG'
else
  echo "  FAIL  .github/workflows/release.yml missing (see docs/release.md)" >&2
  errors=$((errors + 1))
fi

# 11) CD test builds: manual dispatch only, never a release, documented
if [ -f .github/workflows/test-build.yml ]; then
  expect "test builds are manual (workflow_dispatch)" .github/workflows/test-build.yml 'workflow_dispatch'
  expect "test builds documented" docs/release.md 'test-build.yml'
else
  echo "  FAIL  .github/workflows/test-build.yml missing (see AGENTS.md §6)" >&2
  errors=$((errors + 1))
fi

# 12) HANDOFF.md: agent-facing state notes exist and are referenced
if [ -f HANDOFF.md ]; then
  expect "README links HANDOFF.md" README.md 'HANDOFF.md'
  expect "README links HANDOFF.md" README.zh.md 'HANDOFF.md'
  expect "AGENTS.md references HANDOFF.md" AGENTS.md 'HANDOFF.md'
else
  echo "  FAIL  HANDOFF.md missing (AGENTS.md points to it for working state)" >&2
  errors=$((errors + 1))
fi

# 13) secret scan gate wired into the chain and documented
if [ -f githooks/check-secrets ]; then
  expect "secret scan gate wired" githooks/pre-commit 'githooks/check-secrets'
  expect "secret scan documented" docs/checks.md 'githooks/check-secrets'
else
  echo "  FAIL  githooks/check-secrets missing (AGENTS.md §9 secrets discipline)" >&2
  errors=$((errors + 1))
fi

# 14) pre-tag release review: wired into pre-push and documented
if [ -f githooks/pre-tag ]; then
  expect "pre-tag review wired" githooks/pre-push 'githooks/pre-tag'
  expect "pre-tag review documented" docs/checks.md 'githooks/pre-tag'
  expect "pre-tag review in AGENTS.md" AGENTS.md 'githooks/pre-tag'
else
  echo "  FAIL  githooks/pre-tag missing (light release review, see AGENTS.md §5)" >&2
  errors=$((errors + 1))
fi

# 15) the bench model's registry is documented. Every metric and scenario the
#     model declares must appear on the method's page in both languages: a
#     metric added to model.py without a row in benchmarks.md is a metric no
#     reader can look up, and the model's whole claim is that a number without a
#     definition does not exist.
while IFS= read -r metric; do
  [ -n "$metric" ] || continue
  expect "bench metric documented: $metric" docs/benchmarks.md "\`$metric\`"
  expect "bench metric documented (zh): $metric" docs/benchmarks.zh.md "\`$metric\`"
done < <(sed -n 's/.*"id": "\([a-z_0-9]*\)".*/\1/p' bench/src/bench/model.py | sort -u)
while IFS= read -r scenario; do
  [ -n "$scenario" ] || continue
  expect "bench scenario documented: $scenario" docs/benchmarks.md "\`$scenario\`"
  expect "bench scenario documented (zh): $scenario" docs/benchmarks.zh.md "\`$scenario\`"
done < <(sed -n 's/^ *id="\([a-z0-9-]*\)",$/\1/p' bench/src/bench/model.py | sort -u)
expect "just bench-selfcheck documented" docs/checks.md 'just bench-selfcheck'
expect "just bench documented" docs/benchmarks.md 'just bench'
expect "just bench documented (zh)" docs/benchmarks.zh.md 'just bench'
expect "just bench doctor documented" docs/benchmarks.md 'just bench doctor'
expect "just bench compare documented" docs/benchmarks.md 'just bench compare'
expect "just py-typecheck documented" docs/checks.md 'just py-typecheck'

# 16) a key the parser refuses must be in the configuration page's removed-keys
#     tables. The parser carries the registry (REMOVED_KEYS: the keys it refuses,
#     with the advice it hands back), and a refusal the page does not document is
#     an upgrade that dead-ends: the user is told what to remove and never what
#     to write. The reverse drift is what makes this worth having at all — a page
#     that still lists `carrier` among the keys to write, for a carrier that is
#     chosen at runtime, passes every other gate here because `carrier` shows up
#     in prose and in a diagram rather than in a TOML block.
#
#     The page writes a key as `[client.data].default_carrier`, so both sides are
#     normalised before they are compared: brackets dropped, and the page's
#     `<name>` read as the parser's `*`.
#     The comparison is made against a normalised copy of the page rather than
#     by massaging the pattern, so a pattern keeps its own spelling.
normalised=$(mktemp)
sed -e 's/\[//g' -e 's/\]//g' -e 's/<name>/*/g' docs/configuration.md > "$normalised"
while IFS= read -r key; do
  [ -n "$key" ] || continue
  if grep -qF -- "$key" "$normalised"; then
    echo "  ok    removed key documented: $key"
  else
    echo "  FAIL  removed key $key is refused by the parser but has no row in the configuration page's removed-keys tables" >&2
    errors=$((errors + 1))
  fi
done < <(awk '/^const REMOVED_KEYS/{f=1;next} f&&/^\];/{exit} f{
  if ($0 ~ /^[[:space:]]*\([[:space:]]*$/) { want=1; next }
  if (want && $0 ~ /^[[:space:]]*"[a-z][a-zA-Z0-9_.*]*",[[:space:]]*$/) {
    gsub(/[^a-zA-Z0-9_.*]/,"",$0); print; want=0
  }
}' src/config/parsing.rs)
rm -f "$normalised"

# 17) the explicit feature lists that build the release artifacts must be
#     Cargo.toml's default set. Three places name it in full — release.yml's
#     musl entries (the container image), the CI musl job that exists to check
#     that very build, and `just container` — and they have drifted twice: `kcp`
#     (v0.10.0) and `transparent` (v0.11.0, where the CI job's list was the one
#     left behind, so no musl build had ever compiled the L3 code the release
#     shipped). Cargo.toml is the single source; a list that is not the default
#     set is a release artifact that is not the default build.
default_features=$(
  awk '/^default = \[/{f=1;next} f&&/^\]/{exit} f{
         gsub(/[",[:space:]]/,""); if ($0 != "") print
       }' Cargo.toml | paste -sd, -
)
release_musl=$(
  awk '/x86_64-unknown-linux-musl/{seen=1}
       seen && /^[[:space:]]*features:/{sub(/^[[:space:]]*features:[[:space:]]*/,""); print; exit}' \
    .github/workflows/release.yml
)
ci_musl=$(
  awk '/x86_64-unknown-linux-musl/{seen=1}
       seen {for (i=1;i<=NF;i++) if ($i=="--features") {print $(i+1); exit}}' \
    .github/workflows/ci.yml
)
just_container=$(
  awk '/^container:/{seen=1}
       seen {for (i=1;i<=NF;i++) if ($i=="--features") {print $(i+1); exit}}' justfile
)
if [ -z "$default_features" ]; then
  echo "  FAIL  no default feature set read from Cargo.toml [features]" >&2
  errors=$((errors + 1))
else
  for named in "release.yml musl entries=$release_musl" \
               "CI musl job=$ci_musl" \
               "just container=$just_container"; do
    label="${named%%=*}"
    value="${named#*=}"
    if [ "$value" = "$default_features" ]; then
      echo "  ok    $label build the default feature set"
    else
      echo "  FAIL  $label build '$value', not Cargo.toml's default set '$default_features'" >&2
      errors=$((errors + 1))
    fi
  done
fi

# soft notice: stale upstream references are expected only in provenance docs
if grep -qiF 'rathole-org' README.md README.zh.md 2>/dev/null; then
  echo "  note: upstream 'rathole-org' references present (expected: provenance links only)"
fi

if [ "$errors" -eq 0 ]; then
  echo "  docs alignment ok"
else
  echo "  $errors docs alignment issue(s) found" >&2
  exit 1
fi

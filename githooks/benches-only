#!/usr/bin/env bash
# Classify a change set: is every changed path part of the bench project?
#
# Reads paths (one per line) on stdin; exits 0 when all of them are part of
# the bench project (`bench/`) or its published records (`benches/records/`),
# and 1 otherwise.
#
# What this buys: the fast gate (githooks/pre-commit) compiles nothing for
# such a change. The project is runtime tooling — run via `uv run` or as
# plain shell — with one exception, `bench/transport_harness`, which is a Cargo
# package in this workspace: a `.rs`, `Cargo.toml` or `Cargo.lock` under bench/
# therefore classifies as NOT benches-only, so the cargo gates run for it.
# Everything else there is not compiled, linked, or depended on by any Rust
# target, so `cargo fmt`, `cargo machete` and both clippy passes cannot move;
# the quality gates that CAN move (ruff, pyright, the bench-model
# selfcheck, the docs gate that keeps model.py's registry and
# docs/benchmarks.md in lock) all still run. CI keeps the full chain
# regardless (see the note in githooks/pre-commit), so this is a latency
# split, never a coverage split.
#
# Like githooks/docs-only: an empty input is NOT benches-only, a manual run
# from a terminal classifies nothing, and deleting this file makes the hook
# run the full chain again — the safe direction.
set -euo pipefail

if [ -t 0 ]; then
  # A manual run from a terminal has no change set to classify.
  exit 1
fi

benches_only=1
saw_path=0
while IFS= read -r path; do
  [ -n "$path" ] || continue
  saw_path=1
  case "$path" in
    bench/*|benches/records/*) ;;
    *) benches_only=0 ;;
  esac
  # ...except anything under it that is *compiled*. The bench project is runtime
  # tooling with one exception: `bench/transport_harness` is a real Cargo package
  # in this workspace, so a change there can break a build that the skipped
  # cargo gates would have caught. Matching by shape rather than by path keeps
  # that true for the next helper nobody has written yet.
  case "$path" in
    *.rs|*/Cargo.toml|*/Cargo.lock) benches_only=0 ;;
  esac
done

[ "$saw_path" -eq 1 ] || exit 1
[ "$benches_only" -eq 1 ]

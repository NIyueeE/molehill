#!/usr/bin/env bash
# Pre-commit hook (fast gates): format + secret scan + unused deps + docs-sync + python lint/format (ruff) + strict clippy.
# A change limited to markdown, docs/ or assets/ cannot move the code gates, so
# it runs only the two gates it CAN break (the secret scan and the
# docs-alignment check) — the same split CI makes with ci.yml / docs.yml.
# A change limited to benches/scripts/ moves no Rust gate either: the scripts
# are runtime tooling (`uv run` / plain shell), never compiled or linked, so
# the python gates, the bench-model selfcheck and the docs check run and cargo
# skips — CI still runs the full chain on such a change, so this is a latency
# split, never a coverage split.
# Heavyweight gates (audit / deny / outdated / test) live in githooks/pre-push.
# Activate via: git config core.hooksPath githooks   (or: just setup)
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

if git diff --cached --name-only --diff-filter=ACMRD | githooks/docs-only; then
  echo "==> docs-only change: skipping the code gates (fmt / machete / ruff / clippy)"
  echo "==> secret scan (githooks/check-secrets)"
  githooks/check-secrets
  echo "==> docs alignment (githooks/check-docs)"
  githooks/check-docs
  echo "pre-commit checks passed (docs-only)"
  exit 0
fi

if git diff --cached --name-only --diff-filter=ACMRD | githooks/benches-only; then
  echo "==> benches-only change: skipping the cargo gates (fmt / machete / clippy)"
  echo "==> secret scan (githooks/check-secrets)"
  githooks/check-secrets
  echo "==> docs alignment (githooks/check-docs)"
  githooks/check-docs
  echo "==> ruff check (python bench/test entries, see ruff.toml)"
  uvx ruff check benches/scripts/
  echo "==> ruff format --check (same scope; auto-fix with: just py-fmt)"
  uvx ruff format --check benches/scripts/
  echo "==> bench model self-check (metrics, verdict rules, comparability rules)"
  uv run benches/scripts/bench/bench.py selfcheck
  echo "pre-commit checks passed (benches-only)"
  exit 0
fi

echo "==> cargo fmt --check"
cargo fmt --all -- --check

echo "==> secret scan (githooks/check-secrets)"
githooks/check-secrets

echo "==> cargo machete (unused dependencies)"
cargo machete

echo "==> docs alignment (githooks/check-docs)"
githooks/check-docs

echo "==> ruff check (python bench/test entries, see ruff.toml)"
uvx ruff check benches/scripts/

echo "==> ruff format --check (same scope; auto-fix with: just py-fmt)"
uvx ruff format --check benches/scripts/

echo "==> bench model self-check (metrics, verdict rules, comparability rules)"
uv run benches/scripts/bench/bench.py selfcheck

echo "==> cargo clippy (strict lints from Cargo.toml, default features)"
cargo clippy --all-targets -- -D warnings

echo "==> cargo clippy (server+client only — minimal no-default-features build)"
cargo clippy --all-targets --no-default-features --features server,client -- -D warnings

echo "pre-commit checks passed"
